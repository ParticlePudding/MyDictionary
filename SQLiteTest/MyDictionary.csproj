<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 は Windows 10 (1903以降) / 11 に標準搭載 -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MyDictionary</AssemblyName>
    <RootNamespace>MyDictionary</RootNamespace>
    <!-- SQLiteのネイティブDLLと一致させるため x64 固定 -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <!-- 管理DLLとネイティブDLLをexeに埋め込み、単一ファイル化する -->
    <PackageReference Include="Fody" Version="6.8.2" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- SQLiteのネイティブDLL(x64)を exe にリソースとして埋め込む(Costuraが実行時に読み込む) -->
  <ItemGroup>
    <EmbeddedResource Include="$(NuGetPackageRoot)stub.system.data.sqlite.core.netframework\1.0.119\build\net46\x64\SQLite.Interop.dll"
                      LogicalName="costura64.sqlite.interop.dll"
                      Visible="false" />
  </ItemGroup>

</Project>
