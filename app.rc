// 実行ファイルに埋め込むリソース: アイコン、マニフェスト、バージョン情報
1 ICON "assets/app.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "CompanyName", "ParticlePudding"
            VALUE "FileDescription", "MyDictionary"
            VALUE "FileVersion", "2.00"
            VALUE "InternalName", "MyDictionary"
            VALUE "LegalCopyright", "Copyright (C) 2026 ParticlePudding"
            VALUE "OriginalFilename", "MyDictionary.exe"
            VALUE "ProductName", "MyDictionary"
            VALUE "ProductVersion", "2.00"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
